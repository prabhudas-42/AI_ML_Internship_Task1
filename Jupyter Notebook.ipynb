from IPython.display import display
import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# 1. Load the CSV dataset
df = pd.read_csv("student_performance.csv")

print("Dataset loaded successfully!")
print("Dataset shape:", df.shape)
display(df.head())

# 2. Inspect the dataset
print("\nDataset information:")
df.info()

print("\nMissing values:")
print(df.isnull().sum())

print("\nDuplicate rows:", df.duplicated().sum())

# 3. Clean the dataset
df.columns = df.columns.str.strip()
df = df.drop_duplicates().copy()

marks_columns = ["Maths", "Science", "English"]

for column in marks_columns:
    df[column] = pd.to_numeric(df[column], errors="coerce")
    if df[column].notna().any():
        df[column] = df[column].fillna(df[column].mean())

df = df.dropna(subset=["Student_ID", "Name"]).copy()

# 4. Statistical analysis
print("\nStatistical summary:")
display(df[marks_columns].describe().round(2))

print("\nAverage marks by subject:")
display(df[marks_columns].mean().round(2))

# 5. Calculate student averages
df["Average_Marks"] = df[marks_columns].mean(axis=1)

print("\nStudent average marks:")
display(df[["Name", "Average_Marks"]].round(2))

top_student = df.loc[df["Average_Marks"].idxmax()]
print("\nHighest-scoring student:", top_student["Name"])
print("Average marks:", round(top_student["Average_Marks"], 2))

# 6. Graph 1: Bar chart
df[marks_columns].mean().plot(
    kind="bar",
    figsize=(8, 5),
    color=["steelblue", "orange", "seagreen"]
)
plt.title("Average Marks by Subject")
plt.xlabel("Subject")
plt.ylabel("Average Marks")
plt.ylim(0, 100)
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig("visualization1_average_marks.png", dpi=150)
plt.show()

# 7. Graph 2: Histogram
plt.figure(figsize=(8, 5))
plt.hist(df["Average_Marks"], bins=5, edgecolor="black")
plt.title("Distribution of Student Average Marks")
plt.xlabel("Average Marks")
plt.ylabel("Number of Students")
plt.tight_layout()
plt.savefig("visualization2_marks_distribution.png", dpi=150)
plt.show()

# 8. Graph 3: Scatter plot
plt.figure(figsize=(8, 5))
plt.scatter(df["Maths"], df["Science"], color="purple", s=70)
plt.title("Maths Marks vs Science Marks")
plt.xlabel("Maths Marks")
plt.ylabel("Science Marks")
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig("visualization3_maths_vs_science.png", dpi=150)
plt.show()

# 9. Save the cleaned dataset
df.to_csv("cleaned_student_performance.csv", index=False)

# 10. Verify outputs
assert df.shape == (15, 6)
assert df.duplicated().sum() == 0

for filename in [
    "cleaned_student_performance.csv",
    "visualization1_average_marks.png",
    "visualization2_marks_distribution.png",
    "visualization3_maths_vs_science.png"
]:
    assert os.path.isfile(filename), f"Missing file: {filename}"

print("\nSUCCESS: Analysis completed!")
print("All three graphs and the cleaned CSV were saved.")